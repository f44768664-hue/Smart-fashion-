<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Smart Fashion</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
font-family:Arial,sans-serif;
background:#050505;
color:white;
}
header{
background:#050505;
border-bottom:1px solid #222;
padding:18px 6%;
display:flex;
justify-content:space-between;
align-items:center;
position:sticky;
top:0;
z-index:100;
}
.logo{font-size:24px;font-weight:bold}
.logo span{color:#20d66b}
nav a{
color:white;
text-decoration:none;
margin-left:18px;
font-size:14px;
}
nav a:hover{color:#20d66b}

.hero{
min-height:480px;
display:flex;
align-items:center;
padding:70px 7%;
background:linear-gradient(120deg,#050505,#101a13);
}
.hero-text{max-width:650px}
.hero h1{
font-size:50px;
line-height:1.1;
margin-bottom:20px;
}
.hero h1 span{color:#20d66b}
.hero p{
color:#bbb;
font-size:18px;
line-height:1.6;
margin-bottom:28px;
}
.btn{
display:inline-block;
background:#20d66b;
color:#000;
padding:14px 25px;
border-radius:7px;
text-decoration:none;
font-weight:bold;
}

section{padding:55px 7%}
.title{text-align:center;margin-bottom:35px}
.title h2{font-size:32px}
.title p{color:#aaa;margin-top:8px}

.categories{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:18px;
}
.category{
background:#111;
border:1px solid #252525;
padding:35px 15px;
text-align:center;
border-radius:12px;
}
.category h3{margin-top:12px}
.category div{font-size:42px}

.products{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:22px;
}
.product{
background:#111;
border:1px solid #252525;
border-radius:12px;
overflow:hidden;
}
.product-img{
height:230px;
background:#202020;
display:flex;
align-items:center;
justify-content:center;
font-size:70px;
}
.product-info{padding:18px}
.product-info h3{margin-bottom:8px}
.price{
color:#20d66b;
font-size:20px;
font-weight:bold;
margin:10px 0;
}
.product button{
width:100%;
padding:12px;
background:#20d66b;
border:none;
border-radius:6px;
cursor:pointer;
font-weight:bold;
}

.about{
background:#0d0d0d;
text-align:center;
}
.about p{
max-width:750px;
margin:auto;
color:#bbb;
line-height:1.7;
}

.order{
max-width:650px;
margin:auto;
}
form{
background:#111;
padding:25px;
border-radius:12px;
border:1px solid #252525;
}
input,select,textarea{
width:100%;
padding:14px;
margin:8px 0 15px;
background:#050505;
color:white;
border:1px solid #333;
border-radius:6px;
}
textarea{height:100px}
form button{
width:100%;
padding:15px;
background:#20d66b;
border:0;
border-radius:7px;
font-weight:bold;
cursor:pointer;
}

footer{
background:#000;
border-top:1px solid #222;
padding:35px 7%;
text-align:center;
color:#888;
}
footer strong{color:white}
footer span{color:#20d66b}

@media(max-width:800px){
nav{display:none}
.hero{padding:55px 7%}
.hero h1{font-size:38px}
.categories{grid-template-columns:repeat(2,1fr)}
.products{grid-template-columns:1fr}
}
</style>
</head>

